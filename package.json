{
  "name": "ews-aftersales",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "pnpm --filter @ews/web dev",
    "dev:api": "node --env-file=.env --import tsx apps/api/src/server.ts",
    "worker": "node --env-file=.env --import tsx apps/api/src/worker.ts",
    "db:migrate": "node --env-file=.env --import tsx packages/db/migrate.ts",
    "admin:create": "node --env-file=.env --import tsx scripts/create-admin.ts",
    "test": "node --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "typecheck": "tsc --noEmit && pnpm --filter @ews/web typecheck",
    "build": "pnpm --filter @ews/web build",
    "test:e2e": "playwright test",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "dev:qa": "node scripts/qa-launch.mjs",
    "backup": "node --env-file=.env scripts/backup.mjs",
    "test:postgres": "node --env-file=.env scripts/test-postgres.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "fastify": "^5.6.0",
    "nodemailer": "^10.2.1",
    "pg": "^8.16.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.10.0",
    "@types/nodemailer": "^7.0.3",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
